# Copy to .env.local and fill in. Never commit the filled-in copy.
#
# The app runs fine with none of these set. Without a key it simply has no
# closing paragraphs, and without a database the cache lives in memory and is
# lost on restart. Everything measured on the page works either way.

# The key is read from the environment and never written anywhere else.
# Do not paste it into a terminal command, a chat, or any file that is committed.
ANTHROPIC_API_KEY=

# Optional. Defaults to a small, cheap model, which is all the framing needs.
# JOBFIT_MODEL=claude-haiku-4-5-20251001

# Optional. Without this the cache is in-process and resets on restart.
# MYSQL_URL=mysql://user:password@localhost:3306/jobfit

# Optional. How long to wait on the model before giving up and shipping the
# measured result without prose. Milliseconds.
# JOBFIT_FRAMING_TIMEOUT=8000
